<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="ElectronicJournal.Site" %>

<!DOCTYPE html>

<html>
<head runat="server" id="MainHead">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title>Electronic Journal</title>
    <link href="~/Styles/Site.css" rel="stylesheet" type="text/css" />
</head>
<body>
    <form id="MainForm" runat="server">
        <div class="title">
            <asp:Literal ID="Title" runat="server" Text="Electronic Journal"></asp:Literal>
        </div>
        <div class="menu">
            <asp:Menu ID="MainMenu" runat="server" StaticEnableDefaultPopOutImage="false" DataSourceID="MainSiteMapDataSource" Orientation="Horizontal">
            </asp:Menu>
        </div>
        <div>
            <asp:SiteMapDataSource ID="MainSiteMapDataSource" runat="server" ShowStartingNode="false" />
        </div>
        <div class="main-content">
            <asp:ContentPlaceHolder ID="MainContentPlaceHolder" runat="server">
            </asp:ContentPlaceHolder>
        </div>
    </form>
</body>
</html>
